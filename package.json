{
  "name": "station-agent",
  "version": "0.2.0",
  "description": "Local-first AI Agent client with multi-platform GUI automation, MCP protocol, and vector memory",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node src/server.mjs --dev",
    "doctor": "node src/server.mjs --doctor",
    "build:mac": "bash scripts/build-macos-client.sh",
    "verify:mac": "bash scripts/verify-macos-client.sh",
    "test": "node --test tests/*.test.mjs",
    "python:sidecar": "python3 python/agent_core/main.py",
    "python:skill:load": "python3 python/agent_core/main.py --load-skill",
    "python:test": "python3 -c \"import sys; sys.path.insert(0, 'python'); from agent_core.protocol import JSONRPCProtocol; from agent_core.skill_manager import get_skill_manager; p = JSONRPCProtocol(); m = get_skill_manager(); p.register('skill.load', lambda x: m.load(x.get('path'))); print('Python skill system OK')\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai-agent",
    "gui-automation",
    "mcp",
    "multi-platform",
    "local-first",
    "desktop-automation",
    "browser-automation",
    "mobile-automation",
    "vector-search",
    "claude",
    "openai",
    "hermes",
    "gateway",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/station-agent"
  },
  "dependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "better-sqlite3": "^11.10.0",
    "jszip": "^3.10.1",
    "ml-distance": "^4.0.1"
  }
}
