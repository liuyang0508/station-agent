{
  "name": "station-agent",
  "version": "0.2.0",
  "description": "Local-first AI Agent client with multi-platform GUI automation, MCP protocol, and vector memory",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node src/server.mjs --dev",
    "doctor": "node src/server.mjs --doctor",
    "build:mac": "bash scripts/build-macos-client.sh",
    "verify:mac": "bash scripts/verify-macos-client.sh",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai-agent",
    "gui-automation",
    "mcp",
    "multi-platform",
    "local-first",
    "desktop-automation",
    "browser-automation",
    "mobile-automation",
    "vector-search",
    "claude",
    "openai",
    "hermes",
    "opencowork",
    "openclaw"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/station-agent"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "jszip": "^3.10.1",
    "ml-distance": "^4.0.1"
  }
}
